# Database Configuration
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change_me_db_password

# WordPress Configuration
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change_me_db_password
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=false

# WordPress Site Configuration
# Use http:// for local dev. Switch to https:// after SSL is configured on the server.
WORDPRESS_SITE_URL=http://phillyfaithful.com
WORDPRESS_SITE_TITLE=Philly Faithful
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change_me_admin_password
WORDPRESS_ADMIN_EMAIL=admin@phillyfaithful.com

# Nginx Configuration
NGINX_HOST=phillyfaithful.com
NGINX_PORT=80

# WP-CLI WooCommerce Setup
WOOCOMMERCE_STORE_ADDRESS=Philadelphia
WOOCOMMERCE_STORE_CITY=Philadelphia
# WooCommerce expects country:state format (e.g. US:PA)
WOOCOMMERCE_DEFAULT_COUNTRY=US:PA
WOOCOMMERCE_STORE_POSTCODE=19103
WOOCOMMERCE_STORE_COUNTRY=US
WOOCOMMERCE_CURRENCY=USD
